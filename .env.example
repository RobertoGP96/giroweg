# Generated by `pnpm db:env` (neon env pull) into apps/web/.env.local — never commit real values.
# Postgres (Lakebase) — pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Neon Auth (managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32 (app-side, not pulled from Neon)
# Data API (validates JWTs; provides auth.user_id() for RLS)
NEON_DATA_API_URL=
# Object Storage bucket "vehicles" (S3-compatible, private)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
